# XR Poster - Environment Variables Template
# Copy this file to .env.local and fill in your values

# API Configuration (if needed in future)
# VITE_API_URL=https://api.xrposter.com

# Analytics (optional)
# VITE_GA_TRACKING_ID=
# VITE_SENTRY_DSN=

# Feature Flags
VITE_ENABLE_DEBUG_MODE=false
VITE_MAX_POSTERS=10

# Admin panel access gate (placeholder, client-side only — NOT security;
# see src/admin/AdminGate.tsx). Unset = panel open with a warning banner.
# VITE_ADMIN_PASSPHRASE=choose-a-passphrase

# Base URL of the asset-persistence API (empty = persistence disabled, app runs local-only)
VITE_API_BASE_URL=