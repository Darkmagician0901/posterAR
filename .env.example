# Poster-asset API origin. Empty disables asset persistence.
VITE_API_BASE_URL=

# Origin published story documents are served from — the CloudFront
# distribution fronting the S3 bucket, e.g. https://d111111abcdef8.cloudfront.net
# (or the bucket's own origin, e.g. https://<bucket>.s3.<region>.amazonaws.com,
# if no CDN sits in front of it yet).
# Empty disables loading published stories; ?draft=1 still works locally.
VITE_STORY_BASE_URL=

# Origin story assets (frame art, uploaded images) are served from — the
# bucket behind POST /api/story-assets. Empty resolves every v4 asset
# same-origin, which 404s and silently falls back to a transparent pixel: a
# missing image with no error. assetResolver.ts logs one console.warn per
# session when this is unset and a v4 reference needs it, but set it for any
# environment that actually serves story assets.
VITE_ASSET_BASE_URL=

# --- server only, never prefixed with VITE_ (that would inline it in the bundle) ---

# Shared secret required by POST /api/publish. Set it on the Lambda function
# (Configuration -> Environment variables), not here. It must match what the
# studio's publish dialog sends, character for character.
STUDIO_PUBLISH_SECRET=

# S3 bucket that stores both published story documents and uploaded assets.
# Read by POST /api/publish and POST /api/story-assets; unset, both return
# 503 rather than attempt a write with nowhere to put it.
S3_BUCKET=

# AWS region the bucket above lives in. Defaults to us-east-1 when unset, so
# a bucket in any other region will fail every S3 call with a signing/region
# error instead of a clear "not configured" message — set it explicitly.
S3_REGION=

# Origin POST /api/publish prefixes onto the `stories/<id>.json` key it writes,
# to build the URL returned in the response body, e.g.
#   https://<bucket>.s3.<region>.amazonaws.com
# Empty makes the returned url relative ("/stories/<id>.json") instead of
# absolute — the publish itself still succeeds and the artifact is still
# correctly written to S3, but PublishDialog has no real origin to show, so
# its "set VITE_STORY_BASE_URL to..." hint is replaced with a prompt to set
# this variable instead — never a guessed value. Set this on the Lambda
# function, not here.
STORY_PUBLIC_BASE_URL=

# There is deliberately no AWS credential variable here.
#
# The API runs as a Lambda, so it already has an identity: its execution role.
# The AWS SDK picks those credentials up from the runtime automatically, and
# they rotate on their own. Putting a static AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY pair on the function would replace a rotating
# credential with a permanent one — strictly worse, and nothing needs it.
#
# The role itself carries no S3 permissions. Its access to the bucket comes
# from the bucket policy, which means storage can be re-scoped without
# touching IAM at all.
