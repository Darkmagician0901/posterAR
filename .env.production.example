# Production Environment Variables for XR Poster
# Copy this file to .env.production and fill in your values

# Application Configuration
VITE_APP_NAME=XR Poster
VITE_APP_VERSION=1.0.0
VITE_APP_URL=https://main.dxxxxxxxxxxxxx.amplifyapp.com

# Feature Flags
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true

# Poster Configuration
VITE_MAX_POSTERS=10
VITE_MAX_POSTER_SIZE_MB=10
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Performance Configuration
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_TARGET_FPS=60
VITE_MIN_FPS=30

# Analytics (Google Analytics 4)
# Get your tracking ID from: https://analytics.google.com
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Error Tracking (Sentry)
# Get your DSN from: https://sentry.io
VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# API Configuration (if using backend)
# VITE_API_BASE_URL=https://api.xr-poster.com
# VITE_API_TIMEOUT=10000

# CDN Configuration (if using CDN for assets)
# VITE_CDN_URL=https://cdn.xr-poster.com

# Social Media (for sharing features)
# VITE_TWITTER_HANDLE=@xrposter
# VITE_FACEBOOK_APP_ID=xxxxxxxxxxxxx

# Security
# VITE_ENABLE_CSP=true
# VITE_ALLOWED_ORIGINS=https://main.dxxxxxxxxxxxxx.amplifyapp.com

# Build Configuration
VITE_BUILD_TIMESTAMP=auto
VITE_BUILD_COMMIT_SHA=auto