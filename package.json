{
  "name": "xr-poster",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mobile-first AR web application for placing 2D posters using 8th Wall",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "build:demo": "tsc && vite build --config vite.config.demo.ts && node scripts/finish-demo-build.mjs",
    "build:prod": "cross-env NODE_ENV=production npm run build",
    "preview": "vite preview --host",
    "preview:prod": "npm run build:prod && npm run preview",
    "type-check": "tsc --noEmit",
    "deploy:vercel": "vercel --prod",
    "deploy:vercel:preview": "vercel",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:netlify:preview": "netlify deploy",
    "docker:build": "docker build -t xr-poster .",
    "docker:run": "docker run -p 8080:80 xr-poster",
    "docker:compose": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "generate-qr": "node scripts/generate-qr.js",
    "build:8thwall-docs": "node scripts/build-8thwall-docs.mjs",
    "analyze": "vite build --mode analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src server/src",
    "lint:fix": "eslint src server/src --fix && prettier --write src server/src"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/press-start-2p": "^5.2.7",
    "@fontsource/vt323": "^5.3.0",
    "@vercel/blob": "^2.6.1",
    "gifuct-js": "^2.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.160.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-basic-ssl": "^1.0.1",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.9.0",
    "prettier": "^3.9.5",
    "tree-sitter-wasms": "^0.1.12",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.0.8",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.8",
    "web-tree-sitter": "^0.20.8"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
