<svg width="500" height="700" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="500" height="700" fill="#6366f1"/>
  
  <!-- Gradient overlay -->
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6366f1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="500" height="700" fill="url(#grad)"/>
  
  <!-- Border -->
  <rect x="20" y="20" width="460" height="660" fill="none" stroke="white" stroke-width="4"/>
  
  <!-- Title -->
  <text x="250" y="150" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="white" text-anchor="middle">
    XR POSTER
  </text>
  
  <!-- Subtitle -->
  <text x="250" y="200" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle" opacity="0.9">
    Default Poster
  </text>
  
  <!-- Icon/Symbol -->
  <circle cx="250" cy="350" r="80" fill="white" opacity="0.2"/>
  <circle cx="250" cy="350" r="60" fill="none" stroke="white" stroke-width="4"/>
  <path d="M 250 290 L 250 410 M 190 350 L 310 350" stroke="white" stroke-width="4" stroke-linecap="round"/>
  
  <!-- Footer text -->
  <text x="250" y="600" font-family="Arial, sans-serif" font-size="18" fill="white" text-anchor="middle" opacity="0.8">
    Place me in AR!
  </text>
</svg>

