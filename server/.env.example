# Copy to .env and fill in.
#
# For the AWS marker-testbed stack, every value below is emitted ready-made by
# Terraform:  cd infra/terraform && terraform output -raw server_env > ../../server/.env

DATABASE_URL=postgres://user:pass@host:5432/postgres

# --- Real AWS S3 -------------------------------------------------------------
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_PUBLIC_BASE_URL=https://<bucket>.s3.us-east-1.amazonaws.com
# S3_FORCE_PATH_STYLE=false

# --- Supabase / other S3-compatible storage ----------------------------------
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/assets

S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=assets

# Path-style addressing (https://endpoint/bucket/key). Required by Supabase and
# most S3-compatible services; set to false for real AWS S3, which wants
# virtual-hosted style (https://bucket.s3.region.amazonaws.com/key).
# Only the literal strings "true" and "false" are accepted.
S3_FORCE_PATH_STYLE=true

PORT=8787
